# Backend proxy (Next rewrites /api -> backend)
NEXT_PUBLIC_API_URL=http://localhost:8081
BACKEND_URL=http://localhost:8081

# Khalti ePayment (KPG-2) – get from test-admin.khalti.com (sandbox) or admin.khalti.com (prod)
# For sandbox: signup https://test-admin.khalti.com/#/join/merchant, OTP 987654, use live_secret_key
# For prod: https://admin.khalti.com
# Frontend does NOT need secret – only backend needs KHALTI_SECRET_KEY
# Optional: override callback/website urls (defaults to http://localhost:3000/payment/callback and http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
